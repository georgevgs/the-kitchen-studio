---
import AboutPage from "~/components/widgets/AboutPage.astro";
import { changeLanguage } from "~/i18n";

changeLanguage("el");

const meta = {
  title: "Ποιοι Είμαστε | The Kitchen Studio - Έπιπλα Κουζίνας Γλυφάδα",
  description: "Το The Kitchen Studio στη Γλυφάδα σχεδιάζει και κατασκευάζει εξατομικευμένα έπιπλα κουζίνας, μπάνιου και living από το 2000. Εξατομικευμένες λύσεις για κάθε ανάγκη και προϋπολογισμό.",
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Ποιοι Είμαστε - The Kitchen Studio",
  url: "https://www.thekitchenstudio.gr/about-us",
  description: meta.description,
  // Reference the canonical business entity rendered by MetaTags on every page
  mainEntity: { "@id": "https://www.thekitchenstudio.gr/#business" },
};
---

<AboutPage {meta} lang="EL">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />
</AboutPage>
