---
import { t, changeLanguage } from "~/i18n";
import ProductPage from "~/components/widgets/ProductPage.astro";
import ProductGallery from "~/components/widgets/ProductGallery.astro";
import { generateBreadcrumbSchema, generateServiceSchema } from "../../utils/schema";
import corianBathroomSinkImage from "../../assets/images/bath/corian/corian-bathroom-sink.avif";
import corianBathroomSink2Image from "../../assets/images/bath/corian/corian-bathroom-sink-2.avif";
import corianBathroomSink3Image from "../../assets/images/bath/corian/corian-bathroom-sink-3.avif";
import corianBathroomSink4Image from "../../assets/images/bath/corian/corian-bathroom-sink-4.avif";
import corianBathroomSink5Image from "../../assets/images/bath/corian/corian-bathroom-sink-5.avif";
import corianBathroomSink6Image from "../../assets/images/bath/corian/corian-bathroom-sink-6.avif";
import corianBathroomSink7Image from "../../assets/images/bath/corian/corian-bathroom-sink-7.avif";

changeLanguage("el");

const meta = {
    title: t("pages.bath.corian_bath.title"),
    description: t("pages.bath.corian_bath.description")
};

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Αρχική", item: "/" },
  { name: "Μπάνιο", item: "/bath" },
  { name: "Νεροχύτες Corian", item: "/bath/corian-bath" },
]);

const serviceSchema = generateServiceSchema({
  name: t("pages.bath.corian_bath.title"),
  description: t("pages.bath.corian_bath.description"),
  url: "/bath/corian-bath",
  serviceType: "Σχεδιασμός και κατασκευή μπάνιου Corian",
});
---

<ProductPage {meta} lang="EL" group="bath" contentKey="pages.bath.corian_bath" href="/bath/corian-bath">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <ProductGallery group="bath" title={t("pages.bath.corian_bath.title")} images={[
        {
          src: corianBathroomSinkImage,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 1",
        },
        {
          src: corianBathroomSink2Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 2",
        },
        {
          src: corianBathroomSink3Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 3",
        },
        {
          src: corianBathroomSink4Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 4",
        },
        {
          src: corianBathroomSink5Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 5",
        },
        {
          src: corianBathroomSink6Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 6",
        },
        {
          src: corianBathroomSink7Image,
          alt: "Νεροχύτης Corian μπάνιου The Kitchen Studio, φωτογραφία 7",
        },
      ]} />
</ProductPage>
