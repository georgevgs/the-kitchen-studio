---
import { t, changeLanguage } from "~/i18n";
import HubPage from "~/components/widgets/HubPage.astro";
import { localizePath } from "~/i18n";
import { generateItemListSchema } from "../utils/schema";
import modernKitchenImage from "../assets/images/kitchens/modern/modern-kitchen.avif";
import classicKitchenImage from "../assets/images/kitchens/classic/classic-kitchen-5.avif";
import corianKitchenImage from "../assets/images/kitchens/corian/corian-kitchen-countertop.avif";

changeLanguage("el");

const meta = {
    title: t("pages.kitchens.kitchens_category.meta_title"),
    description: t("pages.kitchens.kitchens_category.description"),
};

const kitchensListSchema = generateItemListSchema([
    {
        name: t("pages.kitchens.kitchens_category.categories.text_modern_kitchens"),
        description: t("pages.kitchens.modern_kitchens.description"),
        url: "/kitchens/modern-kitchens",
        image: modernKitchenImage,
    },
    {
        name: t("pages.kitchens.kitchens_category.categories.text_classic_kitchens"),
        description: t("pages.kitchens.classic_kitchens.description"),
        url: "/kitchens/classic-kitchens",
        image: classicKitchenImage,
    },
    {
        name: t("pages.kitchens.kitchens_category.categories.text_corian_kitchens"),
        description: t("pages.kitchens.corian_kitchens.description"),
        url: "/kitchens/corian-kitchens",
        image: corianKitchenImage,
    },
]);

const rows = [
  { text: t("pages.kitchens.kitchens_category.categories.text_modern_kitchens"), href: localizePath("/kitchens/modern-kitchens"), src: modernKitchenImage, alt: "Modern kitchen design with clean lines and minimalist aesthetic" },
  { text: t("pages.kitchens.kitchens_category.categories.text_classic_kitchens"), href: localizePath("/kitchens/classic-kitchens"), src: classicKitchenImage, alt: "Classic kitchen with traditional wood cabinetry and elegant details" },
  { text: t("pages.kitchens.kitchens_category.categories.text_corian_kitchens"), href: localizePath("/kitchens/corian-kitchens"), src: corianKitchenImage, alt: "Corian kitchen with seamless integrated countertops and surfaces" },
];
---

<HubPage {meta} lang="EL" group="kitchens" contentKey="pages.kitchens.kitchens_category" {rows}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(kitchensListSchema)} />
</HubPage>
