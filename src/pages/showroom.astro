---
import { t, changeLanguage } from "~/i18n";
import ShowroomPage from "~/components/widgets/ShowroomPage.astro";
import { processImagesForCarousel } from "~/utils/images";

changeLanguage("el");

const images = processImagesForCarousel("showroom");

const meta = {
  title: t("pages.showroom.meta_title"),
  description: t("pages.showroom.description"),
};
---

<ShowroomPage {meta} lang="EL" {images} />
