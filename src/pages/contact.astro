---
import { changeLanguage } from "~/i18n";
import ContactPage from "~/components/widgets/ContactPage.astro";
import { generateContactPageSchema } from "../utils/schema";

changeLanguage("el");

const meta = {
  title: "Επικοινωνία",
  description: "Επικοινωνήστε με το The Kitchen Studio στη Γλυφάδα: τηλέφωνο 210 8981423, Γρηγορίου Λαμπράκη 28. Κλείστε ραντεβού για δωρεάν μελέτη κουζίνας.",
};

const contactPageSchema = generateContactPageSchema("el");
---

<ContactPage {meta} lang="EL">
  <link rel="preconnect" href="https://maps.googleapis.com" crossorigin slot="head" />
  <link rel="preconnect" href="https://maps.gstatic.com" crossorigin slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(contactPageSchema)} />
</ContactPage>
