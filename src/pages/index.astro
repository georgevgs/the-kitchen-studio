---
import { SITE } from "~/config";
import { getImage } from "astro:assets";
import { HERO_IMAGE } from "~/utils/heroImage";
import Layout from "../layouts/PageLayout.astro";
import { t, changeLanguage } from "~/i18n";
import { heroSlides } from "~/utils/heroSlides";

import Hero from "~/components/widgets/Hero.astro";
import HomeServices from "~/components/widgets/HomeServices.astro";
import HomeWhyUs from "~/components/widgets/HomeWhyUs.astro";
import HomeProjects from "~/components/widgets/HomeProjects.astro";
import HomeProcess from "~/components/widgets/HomeProcess.astro";
import HomePress from "~/components/widgets/HomePress.astro";
import HomeFaq from "~/components/widgets/HomeFaq.astro";

changeLanguage("el");

const images = heroSlides();

// Preload the exact responsive variant the Hero <Image> will render (same options
// via HERO_IMAGE) so the LCP image is discovered early and no unused image is fetched.
const heroPreload = images[0]
  ? await getImage({ src: images[0].src, ...HERO_IMAGE })
  : null;

const lang = "EL";
const meta = {
  title: `${SITE.title} | Έπιπλα Κουζίνας στα μέτρα σας`,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t("home.faq.items.first_item.question"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t("home.faq.items.first_item.answer"),
      },
    },
    {
      "@type": "Question",
      name: t("home.faq.items.second_item.question"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t("home.faq.items.second_item.answer"),
      },
    },
    {
      "@type": "Question",
      name: t("home.faq.items.third_item.question"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t("home.faq.items.third_item.answer"),
      },
    },
    {
      "@type": "Question",
      name: t("home.faq.items.fourth_item.question"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t("home.faq.items.fourth_item.answer"),
      },
    },
  ],
};
---

<Layout {meta} lang={lang} headerTone="overlay">
  {/* All head content must live in a single Fragment: a conditional-expression
      sibling breaks Astro's named-slot assignment for the other elements. */}
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        imagesrcset={heroPreload.srcSet.attribute}
        imagesizes={HERO_IMAGE.sizes}
        fetchpriority="high"
      />
    )}
  </Fragment>

  <Hero images={images} />
  <HomeServices />
  <HomeWhyUs />
  <HomeProjects />
  <HomeProcess />
  <HomePress />
  <HomeFaq />
</Layout>
