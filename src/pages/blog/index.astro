---
import { t, changeLanguage } from "~/i18n";
import BlogIndex from "~/components/widgets/BlogIndex.astro";
import { getAllPosts } from "~/utils/blog";
import type { MetaSEO } from "~/types";
import { generateBreadcrumbSchema } from "~/utils/schema";

changeLanguage("el");

// Get all blog posts
const posts = await getAllPosts("el");

// Site config
const SITE = {
  name: "The Kitchen Studio",
  url: import.meta.env.SITE || "https://thekitchenstudio.gr",
};

// Get canonical URL
const canonicalURL = new URL("/blog", Astro.site).toString();

const meta: MetaSEO = {
  title: t("blog.index.meta_title"),
  description: t("blog.index.meta_description"),
  ogType: "website",
  canonicalURL: canonicalURL,
  keywords: ["blog", "κουζίνα", "συμβουλές", "διακόσμηση", "σχεδιασμός", "ανακαίνιση"],
};

// Generate breadcrumb structured data
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { name: "Home", item: "/" },
    { name: "Blog", item: "/blog" },
  ],
  SITE.url
);
---

<BlogIndex {meta} canonicalURL={canonicalURL} lang="EL" locale="el-GR" {posts}>
  <!-- Add JSON-LD structured data for breadcrumbs -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
</BlogIndex>
