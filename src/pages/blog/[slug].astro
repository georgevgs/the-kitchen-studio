---
import { changeLanguage } from "~/i18n";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogArticle from "~/components/widgets/BlogArticle.astro";
import { calculateReadingTime, getRelatedPosts } from "~/utils/blog";
import type { MetaSEO } from "~/types";
import { collectionEntryToPost } from "~/types";
import { SITE } from "~/config";
import { generateBlogPostSchema, generateBreadcrumbSchema } from "~/utils/schema";

changeLanguage("el");

export interface Props {
  post: CollectionEntry<"blog">;
  relatedPosts?: CollectionEntry<"blog">[];
}

// Generate static paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", (p) => (p.data.lang ?? "el") === "el");

  return Promise.all(
    blogEntries.map(async (post) => {
      const relatedPosts = post.data.tags?.length ? await getRelatedPosts(post, 2) : [];

      return {
        params: { slug: post.id },
        props: { post, relatedPosts },
      };
    })
  );
}

// Get the current post and related posts from props
const { post, relatedPosts = [] } = Astro.props;
const { Content, headings } = await render(post);
const postContent = post.body ?? "";

// Calculate reading time if not provided in frontmatter
const readingTime = post.data.readingTime || calculateReadingTime(postContent);

// Intrinsic sizes of the public/ blog hero images (public assets aren't
// processed by astro:assets, so dimensions must be declared to avoid CLS)
const HERO_DIMENSIONS: Record<string, { width: number; height: number }> = {
  "/assets/images/blog/kitchen-island.avif": { width: 1920, height: 1078 },
  "/assets/images/blog/modern-grey-and-terracotta-kitchen-2025.avif": { width: 1920, height: 1256 },
  "/assets/images/blog/kitchen-renovation-guide.avif": { width: 1920, height: 2363 },
};
const heroDims = post.data.image ? HERO_DIMENSIONS[post.data.image] : undefined;

// Get canonical URL (trailing slash to match the sitemap and hreflang URLs)
const canonicalURL = new URL(`/blog/${post.id}/`, Astro.site).toString();

// Format the post data to match MetaSEO interface
const meta: MetaSEO = {
  title: `${post.data.title} | The Kitchen Studio`,
  description: post.data.description,
  image: post.data.image,
  articlePublishTime: post.data.pubDate,
  ogType: "article",
  canonicalURL: canonicalURL,
  keywords: post.data.tags,
  author: post.data.author,
};

// Map post to match the Post interface required by schema functions
const postForSchema = collectionEntryToPost(post);

// Generate blog post structured data
const blogPostSchema = generateBlogPostSchema(postForSchema, canonicalURL, SITE);

// Generate breadcrumb structured data
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { name: "Αρχική", item: "/" },
    { name: "Blog", item: "/blog/" },
    { name: post.data.title, item: `/blog/${post.id}/` },
  ],
  SITE.origin
);

---

<BlogArticle
  {meta}
  canonicalURL={canonicalURL}
  lang="EL"
  locale="el-GR"
  {post}
  {relatedPosts}
  {readingTime}
  {headings}
  {Content}
  imageSize={heroDims}
>
  <!-- Add JSON-LD structured data for blog post and breadcrumbs -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogPostSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
</BlogArticle>
