---
import { t, changeLanguage } from "~/i18n";
import ProductPage from "~/components/widgets/ProductPage.astro";
import ProductGallery from "~/components/widgets/ProductGallery.astro";
import { processImagesForCarousel } from "~/utils/images";

changeLanguage("el");

const images = processImagesForCarousel("wardrobes");

const meta = {
  title: t("pages.wardrobes.meta_title"),
  description: t("pages.wardrobes.description"),
};
---

<ProductPage {meta} lang="EL" group="products" contentKey="pages.wardrobes" href="/wardrobes">
  <ProductGallery group="products" title={t("pages.wardrobes.title")} images={images} />
</ProductPage>
