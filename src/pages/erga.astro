---
import { t, changeLanguage } from "~/i18n";
import ErgaPage from "~/components/widgets/ErgaPage.astro";
import { processImagesNewestFirst } from "~/utils/images";

changeLanguage("el");

const images = processImagesNewestFirst("erga", "el");

const meta = {
  title: t("pages.erga.title"),
  description: t("pages.erga.description"),
};
---

<ErgaPage {meta} lang="EL" {images} />
