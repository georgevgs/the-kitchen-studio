---
import { t, changeLanguage } from "~/i18n";
import MeletesPage from "~/components/widgets/MeletesPage.astro";
import { processImagesForCarousel } from "~/utils/images";

changeLanguage("en");

const images = processImagesForCarousel("meletes", "en");

const meta = {
  title: t("pages.meletes.title"),
  description: t("pages.meletes.description"),
};
---

<MeletesPage {meta} lang="EN" {images} />
