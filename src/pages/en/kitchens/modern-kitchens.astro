changeLanguage("en");

const meta = {
  title: t("pages.kitchens.modern_kitchens.meta_title"),
  description: t("pages.kitchens.modern_kitchens.description"),
};

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", item: "/en" },
  { name: "Kitchens", item: "/en/kitchens" },
  { name: "Modern Kitchens", item: "/en/kitchens/modern-kitchens" },
]);

const serviceSchema = generateServiceSchema({
  name: t("pages.kitchens.modern_kitchens.title"),
  description: t("pages.kitchens.modern_kitchens.description"),
  url: "/en/kitchens/modern-kitchens",
  serviceType: "Modern kitchen design and manufacturing",
});
---

<ProductPage {meta} lang="EN" group="kitchens" contentKey="pages.kitchens.modern_kitchens" href="/kitchens/modern-kitchens">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <ProductGallery group="kitchens" title={t("pages.kitchens.modern_kitchens.title")} images={[
        {
          src: modernKitchenImage,
