---
import { changeLanguage } from "~/i18n";
import ContactPage from "~/components/widgets/ContactPage.astro";
import { generateContactPageSchema } from "../../utils/schema";

changeLanguage("en");

const meta = {
  title: "Contact Us",
  description: "Contact The Kitchen Studio in Glyfada, Athens: call 210 8981423 or visit us at 28 Grigoriou Lampraki. Book a free kitchen design consultation.",
};

const contactPageSchema = generateContactPageSchema("en");
---

<ContactPage {meta} lang="EN">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(contactPageSchema)} />
</ContactPage>
