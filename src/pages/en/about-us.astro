---
import AboutPage from "~/components/widgets/AboutPage.astro";
import { changeLanguage } from "~/i18n";

changeLanguage("en");

const meta = {
  title: "About Us | The Kitchen Studio - Kitchen Furniture in Glyfada, Athens",
  description: "The Kitchen Studio in Glyfada designs and installs custom kitchen furniture, bathroom cabinets, tiles, wardrobes, and living room furniture. Over 20 years of expertise. Custom solutions for every need and budget.",
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Us - The Kitchen Studio",
  url: "https://www.thekitchenstudio.gr/en/about-us",
  description: meta.description,
  // Reference the canonical business entity rendered by MetaTags on every page
  mainEntity: { "@id": "https://www.thekitchenstudio.gr/#business" },
};
---

<AboutPage {meta} lang="EN">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />
</AboutPage>
