changeLanguage("en");

const meta = {
  title: t("pages.bath.bath_furnitures.title"),
  description: t("pages.bath.bath_furnitures.description"),
};

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", item: "/en" },
  { name: "Bath", item: "/en/bath" },
  { name: "Bathroom Furniture", item: "/en/bath/bath-furnitures" },
]);

const serviceSchema = generateServiceSchema({
  name: t("pages.bath.bath_furnitures.title"),
  description: t("pages.bath.bath_furnitures.description"),
  url: "/en/bath/bath-furnitures",
  serviceType: "Bathroom furniture design and manufacturing",
});
---

<ProductPage {meta} lang="EN" group="bath" contentKey="pages.bath.bath_furnitures" href="/bath/bath-furnitures">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
