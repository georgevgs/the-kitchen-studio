---
import { t, changeLanguage } from "~/i18n";
import HubPage from "~/components/widgets/HubPage.astro";
import { localizePath } from "~/i18n";
import bathFurnituresImage from "../../assets/images/bath/furniture/bath-furniture-2.avif";
import corianBathroomImage from "../../assets/images/bath/corian/corian-bathroom-sink-4.avif";
import ioannisKaradimasImage from "../../assets/images/bath/ioannis-karadimas.avif";

changeLanguage("en");

const meta = {
  title: t("pages.bath.bath_category.meta_title"),
  description: t("pages.bath.bath_category.description"),
};

const rows = [
  { text: t("pages.bath.bath_category.categories.text_bath_furnitures"), href: localizePath("/bath/bath-furnitures"), src: bathFurnituresImage, alt: "bath-furniture" },
  { text: t("pages.bath.bath_category.categories.text_corian_bath"), href: localizePath("/bath/corian-bath"), src: corianBathroomImage, alt: "corian-bath" },
  { text: t("pages.bath.bath_category.categories.text_karadimas"), href: "https://ikaradimas.gr", src: ioannisKaradimasImage, alt: "ioannis-karadimas" },
];
---

<HubPage {meta} lang="EN" group="bath" contentKey="pages.bath.bath_category" {rows}>
</HubPage>
