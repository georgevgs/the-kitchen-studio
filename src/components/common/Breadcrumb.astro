---
import { t, localizePath } from "~/i18n";

interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  trail: Crumb[];
  current: string;
  class?: string;
}

const { trail, current, class: extraClass = "" } = Astro.props;
---

<nav aria-label={t("common.breadcrumb_aria")} class:list={["ks-breadcrumb", extraClass]}>
  <a href={localizePath("/")} class="text-inherit no-underline">{t("common.home")}</a>
  {
    trail.map((crumb) => (
      <>
        <span aria-hidden="true">/</span>
        <a href={localizePath(crumb.href)} class="text-inherit no-underline">
          {crumb.label}
        </a>
      </>
    ))
  }
  <span aria-hidden="true">/</span>
  <span aria-current="page">{current}</span>
</nav>
