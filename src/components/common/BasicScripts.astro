---
import { SITE } from "~/config";
---

<script is:inline data-cfasync="false" define:vars={{ defaultTheme: SITE.defaultTheme }}>
  const THEME_KEY = "theme";
  const isThemeLocked = defaultTheme.endsWith(":only");

  document.documentElement.style.setProperty("--vh", `${window.innerHeight * 0.01}px`);

  function readStoredTheme() {
    try {
      return localStorage.getItem(THEME_KEY);
    } catch (error) {
      return null;
    }
  }

  function storeTheme(theme) {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (error) {
      // Private mode, the theme still applies for this page view.
    }
  }

  function applyTheme(theme) {
    const isDark = "dark" === theme;

    document.documentElement.classList.toggle("dark", isDark);
    document.querySelectorAll("[data-aw-toggle-color-scheme]").forEach((toggle) => {
      toggle.setAttribute("aria-pressed", isDark.toString());
    });
  }

  function switchTheme(isDarkNow) {
    if (isDarkNow) {
      applyTheme("light");
      storeTheme("light");
    } else {
      applyTheme("dark");
      storeTheme("dark");
    }
  }

  function decideInitialTheme() {
    const storedTheme = readStoredTheme();
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

    if (isThemeLocked) {
      return defaultTheme.replace(":only", "");
    }
    if (null === storedTheme && "system" !== defaultTheme) {
      return defaultTheme;
    }
    if ("dark" === storedTheme || (null === storedTheme && prefersDark)) {
      return "dark";
    }

    return "light";
  }

  applyTheme(decideInitialTheme());

  document.querySelectorAll("[data-aw-toggle-color-scheme]").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      if (false === isThemeLocked) {
        switchTheme(document.documentElement.classList.contains("dark"));
      }
    });
  });

  window.onpageshow = function () {
    document.documentElement.classList.add("motion-safe:scroll-smooth");
  };
</script>
