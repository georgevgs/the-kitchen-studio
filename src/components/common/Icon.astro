---
type IconName =
  | "arrow-right"
  | "arrow-left"
  | "chevron-down"
  | "close"
  | "menu"
  | "sun"
  | "moon"
  | "phone"
  | "calendar"
  | "instagram"
  | "facebook"
  | "plus";

export interface Props {
  name: IconName;
  size: number;
}

const PATHS: Record<IconName, string[]> = {
  "arrow-right": ["M5 12h14", "M13 6l6 6-6 6"],
  "arrow-left": ["M19 12H5", "M11 6l-6 6 6 6"],
  "chevron-down": ["M6 9l6 6 6-6"],
  close: ["M6 6l12 12", "M18 6L6 18"],
  menu: ["M4 8h16", "M4 16h16"],
  sun: [
    "M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0",
    "M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4",
  ],
  moon: ["M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"],
  phone: ["M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"],
  calendar: ["M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z", "M3 10h18M8 3v4M16 3v4"],
  instagram: [
    "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5z",
    "M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0",
    "M17.5 6.4v.2",
  ],
  facebook: ["M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"],
  plus: ["M12 5v14", "M5 12h14"],
};

const { name, size } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {PATHS[name].map((path) => <path d={path} />)}
</svg>
