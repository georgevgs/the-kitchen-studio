---
import { SEO } from "astro-seo";
import { getAsset } from "~/utils/permalinks";
import CustomStyles from "~/components/CustomStyles.astro";
import type { MetaSEO } from "~/types";
import { getImageUrl, generateWebsiteSchema, generateLocalBusinessSchema } from "~/utils/schema";
import { SITE } from "~/config";

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.defaultImage,
  ogType = "website",
  canonicalURL,
  articlePublishTime,
  keywords = SITE.keywords,
  author = SITE.name, // Fallback to site name if author not specified
  language = SITE.language, // Use SITE.language instead of defaultLanguage
  dontUseTitleTemplate = false,
}: MetaTagsProps = Astro.props;

// Append the brand to page titles unless the page opts out or already includes it
const pageTitle =
  !dontUseTitleTemplate && title && !title.includes(SITE.name)
    ? `${title} | ${SITE.name}`
    : title;

// Get image URL as string
const imageUrl = getImageUrl(image, SITE.origin);

// Extract OG image dimensions from Astro ImageMetadata if available
const imageMetadata = image && typeof image === "object" && "width" in image && "height" in image
  ? image as { width: number; height: number }
  : null;
const ogImageWidth = imageMetadata?.width ?? 1200;
const ogImageHeight = imageMetadata?.height ?? 630;
const ogImageType = imageUrl?.toLowerCase().includes(".webp")
  ? "image/webp"
  : imageUrl?.toLowerCase().includes(".avif")
  ? "image/avif"
  : imageUrl?.toLowerCase().includes(".png")
  ? "image/png"
  : "image/jpeg";
const ogImageAlt = description || title || SITE.name;

// Format canonical URL
const ogCanonicalURL = canonicalURL ? new URL(canonicalURL, Astro.site) : new URL(Astro.url.pathname, Astro.site);

// Format publish date for articles
const articlePublishDate = articlePublishTime ? new Date(articlePublishTime).toISOString() : undefined;

// Canonical business entity (FurnitureStore), referenced by other schemas via @id
const businessSchema = generateLocalBusinessSchema();

// Website Schema
// Convert defaultImage to a string URL for compatibility
const siteConfig = {
  ...SITE,
  defaultImage: getImageUrl(SITE.defaultImage, SITE.origin),
};
const websiteSchema = generateWebsiteSchema(siteConfig, language);

// Define types for meta and link tags
interface MetaTag {
  name: string;
  content: string;
  media?: string;
}

// Process keywords into a string if they're an array
const keywordsString = Array.isArray(keywords) ? keywords.join(", ") : keywords || "";

// Configure SEO props
const seoProps = {
  title: pageTitle,
  description: description,
  canonical: ogCanonicalURL.toString(),
  openGraph: {
    basic: {
      title: pageTitle,
      type: ogType,
      image: imageUrl || "",
      url: ogCanonicalURL.toString(),
    },
    optional: {
      // og:locale expects underscore format (el_GR), not BCP 47 (el-GR)
      locale: language === "en" ? "en_US" : "el_GR",
      siteName: SITE.name,
      description: description,
    },
    image: {
      url: imageUrl || "",
      type: ogImageType,
      width: ogImageWidth,
      height: ogImageHeight,
      alt: ogImageAlt,
    },
    article:
      ogType === "article"
        ? {
            publishedTime: articlePublishDate,
            authors: [author || SITE.name],
            tags: Array.isArray(keywords) ? keywords : keywords?.split(",").map((k) => k.trim()) || [],
          }
        : undefined,
  },
  twitter: {
    creator: "@thekitchenstudio",
    card: "summary_large_image",
    image: imageUrl || "",
    imageAlt: ogImageAlt,
    title: pageTitle,
    description: description,
  },
  extend: {
    meta: [
      { name: "msapplication-TileColor", content: "#000000" },
      { name: "generator", content: Astro.generator },
      { name: "format-detection", content: "telephone=no" },
      { name: "mobile-web-app-capable", content: "yes" },
      { name: "apple-mobile-web-app-title", content: SITE.name },
      { name: "application-name", content: SITE.name },
      ...(keywordsString ? [{ name: "keywords", content: keywordsString }] : []),
      ...(author ? [{ name: "author", content: author }] : []),
      { name: "robots", content: "max-image-preview:large, max-snippet:-1, max-video-preview:-1" },
    ] as MetaTag[],
  },
} as const;

// Generate hrefLang alternate URLs for bilingual el/en site
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/') || currentPath === '/en';
const elPath = isEnglish ? currentPath.replace(/^\/en/, '') || '/' : currentPath;
const enPath = isEnglish ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`;
const elUrl = `${SITE.origin}${elPath}`;
const enUrl = `${SITE.origin}${enPath}`;

---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<SEO {...seoProps} />

<CustomStyles />

<link rel="shortcut icon" href={getAsset("/favicon.ico")} />
<link rel="icon" type="image/svg+xml" href={getAsset("/favicon.svg")} />
<link rel="mask-icon" href={getAsset("/favicon.svg")} color="#000000" />
<link rel="apple-touch-icon" href={getAsset("/apple-touch-icon.png")} />
<link rel="manifest" href={getAsset("/site.webmanifest")} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />
<link rel="dns-prefetch" href="https://formspree.io" />
<link rel="alternate" hreflang="el" href={elUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={elUrl} />

<!-- Add the structured data -->
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- Allow for additional structured data from page templates -->
<slot />

<!-- 100% privacy-first analytics -->
<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
