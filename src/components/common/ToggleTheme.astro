---
import { t } from "~/i18n";
import Icon from "~/components/common/Icon.astro";
---

<button
  type="button"
  class="inline-flex h-11 w-11 items-center justify-center rounded-full"
  aria-label={t("nav.theme_toggle")}
  aria-pressed="false"
  data-aw-toggle-color-scheme
>
  <span class="ks-theme-sun"><Icon name="sun" size={20} /></span>
  <span class="ks-theme-moon"><Icon name="moon" size={20} /></span>
</button>
