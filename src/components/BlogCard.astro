---
import type { CollectionEntry } from "astro:content";
import { localizePath } from "~/i18n";
import { formatDate, getUrlSlug } from "~/utils/blog";

export interface Props {
  post: CollectionEntry<"blog">;
  locale: string;
  isRelated: boolean;
}

const { post, locale, isRelated } = Astro.props;
const { data } = post;

const href = localizePath(`/blog/${getUrlSlug(post)}`);
---

<a href={href} class="ks-card flex flex-col gap-[18px] text-inherit no-underline">
  <div class="aspect-[3/2] overflow-hidden bg-surface">
    <img
      src={data.image}
      alt={data.title}
      loading="lazy"
      decoding="async"
      class="ks-rise block h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-col gap-3">
    <time datetime={data.pubDate.toISOString()} class="ks-eyebrow">{formatDate(data.pubDate, locale)}</time>
    <h3 class="m-0 font-display text-[24px] font-medium leading-[1.2] tracking-[-0.01em]">{data.title}</h3>
    <p
      class:list={["ks-text m-0", { hidden: isRelated }]}
    >
      {data.description}
    </p>
  </div>
</a>
