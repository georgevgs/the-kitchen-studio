---
import Icon from "~/components/common/Icon.astro";
import { t } from "~/i18n";

export interface Props {
  label: string;
}

const { label } = Astro.props;
---

<dialog class="ks-lightbox" aria-label={label} data-lightbox>
  <div class="flex items-center justify-between gap-4 px-[clamp(16px,3vw,32px)] py-3">
    <span aria-live="polite" class="text-[13px] tracking-[0.12em]" data-lightbox-counter></span>
    <button type="button" class="ks-icon-btn ks-chip-night" aria-label={t("common.close")} data-lightbox-close>
      <Icon name="close" size={20} />
    </button>
  </div>
  <div class="relative flex min-h-0 flex-1 items-center justify-center px-[clamp(16px,6vw,88px)] pb-8 pt-2">
    <img alt="" class="block max-h-full max-w-full object-contain" data-lightbox-image />
    <button
      type="button"
      class="ks-icon-btn ks-chip-night absolute left-[clamp(8px,2vw,24px)] top-1/2 h-[52px] w-[52px] -translate-y-1/2 bg-[rgb(12_12_11/0.6)]"
      aria-label={t("common.previous")}
      data-lightbox-previous
    >
      <Icon name="arrow-left" size={20} />
    </button>
    <button
      type="button"
      class="ks-icon-btn ks-chip-night absolute right-[clamp(8px,2vw,24px)] top-1/2 h-[52px] w-[52px] -translate-y-1/2 bg-[rgb(12_12_11/0.6)]"
      aria-label={t("common.next")}
      data-lightbox-next
    >
      <Icon name="arrow-right" size={20} />
    </button>
  </div>
</dialog>

<script>
  const SWIPE_DISTANCE = 50;

  const padNumber = (value: number) => value.toString().padStart(2, "0");

  function initLightbox(dialog: HTMLDialogElement) {
    const triggers = Array.from(document.querySelectorAll<HTMLElement>("[data-lightbox-src]"));
    const openers = document.querySelectorAll<HTMLElement>("[data-lightbox-open-first]");
    const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const previousButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-previous]");
    const nextButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const state = { index: 0, touchStartX: 0 };

    const show = (nextIndex: number) => {
      const total = triggers.length;

      state.index = (nextIndex + total) % total;
      const trigger = triggers[state.index];

      if (null !== image && null !== counter) {
        image.src = trigger.dataset.lightboxSrc ?? "";
        image.alt = trigger.dataset.lightboxAlt ?? "";
        counter.textContent = `${padNumber(state.index + 1)} / ${padNumber(total)}`;
      }
    };

    const open = (index: number) => {
      show(index);
      document.body.classList.add("overflow-hidden");
      dialog.showModal();
    };

    triggers.forEach((trigger, position) => trigger.addEventListener("click", () => open(position)));
    openers.forEach((opener) => opener.addEventListener("click", () => open(0)));

    if (null !== closeButton && null !== previousButton && null !== nextButton) {
      closeButton.addEventListener("click", () => dialog.close());
      previousButton.addEventListener("click", () => show(state.index - 1));
      nextButton.addEventListener("click", () => show(state.index + 1));
    }

    dialog.addEventListener("close", () => document.body.classList.remove("overflow-hidden"));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
    dialog.addEventListener("keydown", (event) => {
      if ("ArrowLeft" === event.key) {
        show(state.index - 1);
      } else if ("ArrowRight" === event.key) {
        show(state.index + 1);
      }
    });
    dialog.addEventListener(
      "touchstart",
      (event) => {
        state.touchStartX = event.changedTouches[0].clientX;
      },
      { passive: true },
    );
    dialog.addEventListener(
      "touchend",
      (event) => {
        const distance = event.changedTouches[0].clientX - state.touchStartX;

        if (SWIPE_DISTANCE < Math.abs(distance) && distance > 0) {
          show(state.index - 1);
        } else if (SWIPE_DISTANCE < Math.abs(distance)) {
          show(state.index + 1);
        }
      },
      { passive: true },
    );
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");

  if (null !== dialog) {
    initLightbox(dialog);
  }
</script>
