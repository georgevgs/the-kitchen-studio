---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "~/components/common/Icon.astro";
import DisplayHeading from "~/components/common/DisplayHeading.astro";
import { t, localizePath } from "~/i18n";
import { HERO_IMAGE } from "~/utils/heroImage";

interface HeroImage {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  images: HeroImage[];
}

const CHIPS = [
  { labelKey: "home.services.items.kitchens.title", href: "/kitchens" },
  { labelKey: "home.services.items.bath.title", href: "/bath" },
  { labelKey: "home.services.items.tiles.title", href: "/tiles" },
  { labelKey: "home.services.items.wardrobes.title", href: "/wardrobes" },
  { labelKey: "home.services.items.doors.title", href: "/doors" },
  { labelKey: "home.services.items.living.title", href: "/living" },
];

const LOADING_BY_POSITION: Record<string, "eager" | "lazy"> = { true: "eager", false: "lazy" };
const PRIORITY_BY_POSITION: Record<string, "high" | "low"> = { true: "high", false: "low" };

const { images } = Astro.props;
const total = images.length.toString().padStart(2, "0");
---

<section
  id="top"
  aria-label={t("home.hero.aria")}
  class="relative flex min-h-[min(880px,100svh)] flex-col justify-end overflow-hidden bg-[#2b2925] text-white"
  data-slider
  data-slider-autoplay="true"
>
  {
    images.map((image, index) => (
      <Image
        src={image.src}
        alt={image.alt}
        widths={HERO_IMAGE.widths}
        sizes={HERO_IMAGE.sizes}
        format={HERO_IMAGE.format}
        quality={HERO_IMAGE.quality}
        class="ks-slide absolute inset-0 h-full w-full object-cover opacity-0 data-[active=true]:opacity-100"
        data-slide
        data-active={(0 === index).toString()}
        aria-hidden={0 !== index}
        loading={LOADING_BY_POSITION[(0 === index).toString()]}
        decoding="async"
        fetchpriority={PRIORITY_BY_POSITION[(0 === index).toString()]}
      />
    ))
  }
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[linear-gradient(180deg,rgb(10_10_10/0.55)_0%,rgb(10_10_10/0.4)_22%,rgb(10_10_10/0.5)_55%,rgb(10_10_10/0.88)_100%)] desk:bg-[linear-gradient(180deg,rgb(10_10_10/0.5)_0%,rgb(10_10_10/0.05)_20%,rgb(10_10_10/0.45)_50%,rgb(10_10_10/0.9)_100%)]"
  >
  </div>

  <div class="ks-container relative flex w-full flex-col gap-11 pb-10 pt-[140px] [text-shadow:0_0_24px_rgb(0_0_0/0.35)]">
    <div class="flex flex-wrap items-end justify-between gap-10">
      <div class="flex min-w-0 flex-[1_1_640px] flex-col gap-[26px]">
        <p class="m-0 text-[12px] uppercase tracking-[0.16em]">{t("home.hero.eyebrow")}</p>
        <DisplayHeading
          as="h1"
          size="hero"
          before={t("home.hero.title")}
          emphasis={t("home.hero.title_emphasis")}
          class="max-w-[980px]"
        />
        <p class="m-0 max-w-[540px] text-[18px] font-normal leading-[1.6] text-white">
          {t("home.hero.subtitle")}
        </p>
        <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={localizePath("/contact")} class="ks-btn">
            {t("home.hero.cta")}
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={localizePath("/erga")} class="ks-link text-[16px] font-medium text-white">
            {t("home.hero.secondary")}
          </a>
        </div>
      </div>
      <div class="flex items-center gap-3.5">
        <span class="ks-italic-number text-[40px]" data-slider-current aria-live="polite">01</span>
        <span class="text-[12px] text-white/80">/ {total}</span>
        <button
          type="button"
          class="ks-icon-btn ks-icon-btn-light ml-2.5"
          aria-label={t("home.hero.previous")}
          data-slider-previous
        >
          <Icon name="arrow-left" size={18} />
        </button>
        <button
          type="button"
          class="ks-icon-btn ks-icon-btn-light"
          aria-label={t("home.hero.next")}
          data-slider-next
        >
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
    <nav aria-label={t("home.hero.categories_aria")} class="flex flex-wrap gap-2.5 border-t border-white/35 pt-6">
      {
        CHIPS.map((chip) => (
          <a href={localizePath(chip.href)} class="ks-chip ks-chip-light">
            {t(chip.labelKey)}
          </a>
        ))
      }
    </nav>
  </div>
</section>

<script>
  import "~/js/slider.ts";
</script>
