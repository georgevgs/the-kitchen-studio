---
import { Image } from "astro:assets";
import DisplayHeading from "~/components/common/DisplayHeading.astro";
import { t } from "~/i18n";
import villasImage from "~/assets/images/villas-magazine-the-kitchen-studio.avif";

const POINTS = ["first", "second", "third"];
---

<section class="ks-container py-[104px]">
  <div class="flex flex-wrap items-center gap-x-20 gap-y-14">
    <div
      class="flex min-w-0 flex-[1_1_480px] items-center justify-center bg-surface px-6 py-[clamp(40px,6vw,88px)]"
    >
      <Image
        src={villasImage}
        alt={t("home.media.villas.alt")}
        widths={[340, 680]}
        sizes="340px"
        loading="lazy"
        class="block h-auto w-[min(340px,100%)] rotate-[-3deg] shadow-[0_40px_70px_-30px_rgb(21_21_21/0.45)]"
      />
    </div>
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-6">
      <p class="ks-eyebrow m-0"><span class="ks-eyebrow-index">(05)</span> {t("home.media.title")}</p>
      <DisplayHeading
        as="h2"
        size="md"
        before={t("home.press.title")}
        emphasis={t("home.press.title_emphasis")}
      />
      <p class="m-0 max-w-[480px] text-[17px] font-normal leading-[1.6] text-copy">
        {t("home.media.villas.description")}
      </p>
      <ul class="m-0 flex list-none flex-col gap-3 p-0 text-[16px]">
        {
          POINTS.map((point) => (
            <li class="flex items-center gap-3">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-brand-fill" />
              {t(`home.media.villas.features.${point}`)}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
