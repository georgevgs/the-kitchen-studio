---
import type { ImageMetadata } from "astro";
import ShowWhen from "~/components/common/ShowWhen.astro";
import LightboxTrigger from "~/components/widgets/LightboxTrigger.astro";
import { t } from "~/i18n";

interface PhotoSource {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  group: "kitchens" | "bath" | "products";
  title: string;
  images: PhotoSource[];
}

const INCLUDED = ["first", "second", "third", "fourth", "fifth", "sixth"];

const TILE_CLASSES = [
  { tile: "md:col-span-4", image: "aspect-[16/9] w-full object-cover", sizes: "(min-width: 768px) 66vw, 100vw" },
  { tile: "md:col-span-2", image: "h-full min-h-[260px] w-full object-cover", sizes: "(min-width: 768px) 33vw, 100vw" },
  { tile: "md:col-span-2", image: "aspect-[4/5] w-full object-cover", sizes: "(min-width: 768px) 33vw, 100vw" },
  { tile: "md:col-span-2", image: "aspect-[4/5] w-full object-cover", sizes: "(min-width: 768px) 33vw, 100vw" },
  { tile: "md:col-span-2", image: "aspect-[4/5] w-full object-cover", sizes: "(min-width: 768px) 33vw, 100vw" },
];

const { group, title, images } = Astro.props;

const [leadImage, ...galleryImages] = images;
const total = images.length.toString().padStart(2, "0");
---

  <figure class="ks-container">
    <LightboxTrigger
      image={leadImage}
      position={1}
      sizes="(min-width: 1440px) 1344px, 92vw"
      imageClass="aspect-[4/3] w-full object-cover object-[50%_45%] md:aspect-[21/9]"
      class="w-full"
      loading="eager"
    />
    <figcaption
      class="flex justify-between gap-4 pt-3.5 text-[11px] uppercase tracking-[0.1em] text-quiet"
    >
      <span>{title}</span><span>01 / {total}</span>
    </figcaption>
  </figure>

  <ShowWhen isVisible={"kitchens" === group}>
    <section class="ks-container py-24">
      <div class="flex flex-wrap gap-x-16 gap-y-8">
        <p class="ks-eyebrow m-0 flex-[1_1_220px]">
          <span class="ks-eyebrow-index">(01)</span> {t("product.included_eyebrow")}
        </p>
        <ul
          class="ks-rows m-0 grid min-w-0 flex-[999_1_640px] list-none grid-cols-[repeat(auto-fit,minmax(min(220px,100%),1fr))] gap-x-8 p-0"
        >
          {
            INCLUDED.map((item) => (
              <li class="py-5 text-[17px] leading-[1.45]">{t(`product.included.${item}`)}</li>
            ))
          }
        </ul>
      </div>
    </section>
  </ShowWhen>

  <section aria-label={t("common.photos")} class="ks-container pb-[104px] pt-16">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 class="ks-display-md m-0">
        {t("common.photos")}
        <sup class="text-[14px] tracking-normal text-brand">{images.length}</sup>
      </h2>
      <p class="ks-eyebrow m-0">{t("common.click_to_zoom")}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-6">
      {
        galleryImages.map((image, index) => (
          <LightboxTrigger
            image={image}
            position={index + 2}
            sizes={TILE_CLASSES[index % TILE_CLASSES.length].sizes}
            imageClass={TILE_CLASSES[index % TILE_CLASSES.length].image}
            class={TILE_CLASSES[index % TILE_CLASSES.length].tile}
          />
        ))
      }
    </div>
  </section>

