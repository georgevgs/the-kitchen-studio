---
export interface Props {
  lang?: "EN" | "EL";
}

const { lang = "EL" } = Astro.props;

const copy =
  lang === "EN"
    ? {
        title: "Summer holidays",
        text: "Our store remains closed until",
        date: "29/8",
      }
    : {
        title: "Καλοκαιρινές διακοπές",
        text: "Το κατάστημα παραμένει κλειστό έως τις",
        date: "29/8",
      };
---

<div class="banner" role="status">
  <div class="inner">
    <span class="dot" aria-hidden="true"></span>
    <span class="label">{copy.title}</span>
    <span class="text">{copy.text} <span class="date">{copy.date}</span></span>
  </div>
</div>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    color: #40403a;
    background: linear-gradient(
      100deg,
      #fdf3e3,
      #f2ece1,
      #e6f1f0,
      #dfeef4,
      #fdf3e3
    );
    background-size: 300% 100%;
    animation: pan 24s ease-in-out infinite;
    border-bottom: 1px solid rgba(64, 64, 58, 0.08);
  }

  :global(.dark) .banner {
    color: #d6d1c7;
    background: linear-gradient(
      100deg,
      #23211d,
      #1c1c1b,
      #1a2222,
      #182226,
      #23211d
    );
    background-size: 300% 100%;
    border-bottom-color: rgba(214, 209, 199, 0.1);
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    text-align: center;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: #e3a04a;
    box-shadow: 0 0 0 0 rgba(227, 160, 74, 0.55);
    animation: pulse 2.8s ease-out infinite;
    flex: none;
  }

  .label {
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
  }

  .text {
    font-size: 1rem;
    letter-spacing: 0.01em;
    opacity: 0.9;
  }

  .date {
    display: inline-block;
    padding: 0.15rem 0.7rem;
    margin-left: 0.25rem;
    border-radius: 9999px;
    background: rgba(227, 160, 74, 0.18);
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  :global(.dark) .date {
    background: rgba(227, 160, 74, 0.22);
  }

  @keyframes pan {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(227, 160, 74, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(227, 160, 74, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(227, 160, 74, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner,
    .dot {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .inner {
      gap: 0.5rem;
      padding: 0.85rem 1rem;
    }
    .label {
      font-size: 0.75rem;
    }
    .text {
      font-size: 0.9375rem;
    }
  }
</style>
