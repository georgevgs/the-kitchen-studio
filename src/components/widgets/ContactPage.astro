---
import { Image } from "astro:assets";
import Layout from "~/layouts/PageLayout.astro";
import Breadcrumb from "~/components/common/Breadcrumb.astro";
import DisplayHeading from "~/components/common/DisplayHeading.astro";
import Icon from "~/components/common/Icon.astro";
import { t, localizePath } from "~/i18n";
import { BUSINESS } from "~/data";
import type { MetaSEO } from "~/types";
import facadeImage from "~/assets/images/showroom/showroom.avif";

export interface Props {
  meta: MetaSEO;
  lang: "EL" | "EN";
}

const SPACES = ["kitchen", "bath", "wardrobe", "other"];
const FORM_ENDPOINT = "https://formspree.io/f/xzzppyrb";

const { meta, lang } = Astro.props;

const labelClass = "text-[14px] text-copy";
const errorClass = "hidden text-[13px] text-[#c0392b]";
const fieldGroupClass = "flex flex-col gap-2";
const legendClass = "mb-3.5 p-0 text-[12px] uppercase tracking-[0.14em] text-quiet";
const detailRowClass = "grid grid-cols-[110px_minmax(0,1fr)] gap-4 border-b border-line py-4";
const detailLabelClass = "pt-[3px] text-[12px] uppercase tracking-[0.1em] text-quiet";
---

<Layout {meta} {lang} footerCta={false}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  <section class="ks-container pb-16 pt-14">
    <Breadcrumb trail={[]} current={t("nav.appointment")} class="mb-14" />
    <DisplayHeading
      as="h1"
      size="lg"
      before={t("contact.title_before")}
      emphasis={t("contact.title_emphasis")}
    />
    <p class="ks-lead mt-7 max-w-[560px]">{t("contact.lead")}</p>
  </section>

  <section class="ks-container flex flex-wrap items-start gap-x-20 gap-y-14 pb-[104px]">
    <div class="min-w-0 flex-[3_1_560px]">
      <form
        action={FORM_ENDPOINT}
        method="POST"
        id="contact-form"
        name="contact"
        aria-label={t("contact.form_aria")}
        novalidate
        class="border-t border-ink-line pt-8"
        data-message-required={t("contact.required")}
        data-message-fill-all={t("contact.fill_all")}
        data-message-success={t("contact.success_message")}
        data-message-error={t("contact.error")}
      >
        <div id="form-inputs" class="flex flex-col gap-9">
          <input type="hidden" name="form-name" value="contact" />
          <div class="hidden">
            <label for="person-title">{t("contact.title")}</label>
            <input id="person-title" name="person-title" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset class="m-0 flex flex-col border-0 p-0">
            <legend class={legendClass}><span class="text-brand">01</span> · {t("contact.space_legend")}</legend>
            <div class="flex flex-wrap gap-2">
              {
                SPACES.map((space, index) => (
                  <label class="relative">
                    <input
                      type="radio"
                      name="space"
                      value={space}
                      checked={0 === index}
                      class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0"
                    />
                    <span class="ks-chip min-h-12 px-5 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-ground peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
                      {t(`contact.space_${space}`)}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="m-0 flex flex-col gap-5 border-0 p-0">
            <legend class={legendClass}><span class="text-brand">02</span> · {t("contact.details_legend")}</legend>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-x-6 gap-y-5">
              <div class={fieldGroupClass}>
                <label for="name" class={labelClass}>{t("contact.name")} *</label>
                <input
                  class="ks-field"
                  id="name"
                  type="text"
                  name="name"
                  autocomplete="name"
                  required
                  aria-required="true"
                  aria-describedby="name-error"
                />
                <p id="name-error" class={errorClass} role="alert"></p>
              </div>
              <div class={fieldGroupClass}>
                <label for="phone" class={labelClass}>{t("contact.phone_optional")}</label>
                <input
                  class="ks-field"
                  id="phone"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                />
              </div>
            </div>
            <div class={fieldGroupClass}>
              <label for="email" class={labelClass}>{t("contact.email")} *</label>
              <input
                class="ks-field"
                id="email"
                type="email"
                name="email"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="email-error"
              />
              <p id="email-error" class={errorClass} role="alert"></p>
            </div>
            <div class={fieldGroupClass}>
              <label for="message" class={labelClass}>{t("contact.message")} *</label>
              <textarea
                class="ks-field"
                id="message"
                name="message"
                rows="4"
                required
                aria-required="true"
                aria-describedby="message-error"
              ></textarea>
              <p id="message-error" class={errorClass} role="alert"></p>
            </div>
          </fieldset>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              name="terms"
              id="terms"
              required
              aria-required="true"
              class="mt-px h-[22px] w-[22px] shrink-0 accent-[var(--ks-ink)]"
            />
            <label for="terms" class="text-[15px] leading-normal text-copy">
              {t("contact.terms_a")}
              <a href={localizePath("/privacy")} target="_blank" class="ks-link text-ink">{t("contact.terms_b")}</a>
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-line pt-6">
            <button id="submit-btn" class="ks-btn min-h-14 px-8" type="submit">
              <span id="submit-text">{t("contact.send")}</span>
              <span id="submit-loading" class="hidden" aria-live="polite">{t("contact.sending")}</span>
              <Icon name="arrow-right" size={18} />
            </button>
          </div>
        </div>

        <div id="success-message" role="status" class="hidden" data-status="success">
          <div class="flex flex-col gap-5 bg-night p-10 text-night-ink">
            <p class="ks-italic-number m-0 text-[44px]" data-status-title>{t("contact.thanks")}</p>
            <p class="m-0 text-[18px] font-normal leading-[1.6] text-night-quiet" data-status-text></p>
            <button type="button" class="ks-chip ks-chip-night self-start bg-transparent" data-form-reset>
              {t("contact.new_message")}
            </button>
          </div>
        </div>
      </form>
    </div>

    <aside class="flex min-w-0 flex-[2_1_380px] flex-col gap-7">
      <Image
        src={facadeImage}
        alt={t("contact.image_alt")}
        widths={[480, 720, 960]}
        sizes="(min-width: 1100px) 36vw, 100vw"
        loading="lazy"
        class="block aspect-[2/1] w-full object-cover"
      />
      <div class="grid grid-cols-2 gap-2.5">
        <a
          href={BUSINESS.phoneHref}
          class="flex min-h-[52px] items-center justify-center gap-2.5 border border-ink-line text-[15px] text-inherit no-underline"
        >
          <Icon name="phone" size={18} />
          {t("contact.call")}
        </a>
        <a
          href={`mailto:${BUSINESS.email}`}
          class="flex min-h-[52px] items-center justify-center gap-2.5 border border-ink-line text-[15px] text-inherit no-underline"
        >
          {t("contact.email_label")}
        </a>
      </div>
      <dl class="m-0 flex flex-col border-t border-ink-line">
        <div class={detailRowClass}>
          <dt class={detailLabelClass}>{t("contact.showroom_label")}</dt>
          <dd class="m-0 text-[16px] leading-normal">{t("business.address")}</dd>
        </div>
        <div class={detailRowClass}>
          <dt class={detailLabelClass}>{t("business.phone_label")}</dt>
          <dd class="m-0 text-[16px]"><a href={BUSINESS.phoneHref} class="text-inherit no-underline">{BUSINESS.phoneDisplay}</a></dd>
        </div>
        <div class={detailRowClass}>
          <dt class={detailLabelClass}>{t("contact.email_label")}</dt>
          <dd class="m-0 break-words text-[16px]">
            <a href={`mailto:${BUSINESS.email}`} class="text-inherit no-underline">{BUSINESS.email}</a>
          </dd>
        </div>
        <div class={detailRowClass}>
          <dt class={detailLabelClass}>{t("contact.hours_label")}</dt>
          <dd class="m-0 text-[16px] leading-[1.6]">
            {t("business.days_morning")}<br />{BUSINESS.morningHours}<br />
            {t("business.days_evening")}<br />{BUSINESS.eveningHours}
          </dd>
        </div>
      </dl>
      <nav class="flex gap-4" aria-label={t("contact.social_aria")}>
        <a href={BUSINESS.instagramHref} target="_blank" rel="noopener noreferrer" class="ks-link text-[15px] font-medium">Instagram</a>
        <a href={BUSINESS.facebookHref} target="_blank" rel="noopener noreferrer" class="ks-link text-[15px] font-medium">Facebook</a>
      </nav>
    </aside>
  </section>

  <section aria-label={t("contact.map_aria")}>
    <iframe
      title={t("contact.map_title")}
      src={BUSINESS.mapEmbedHref}
      class="block h-[440px] w-full border-0 grayscale"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </section>
</Layout>

<script>
  import "~/js/contact.ts";
</script>
