---
import { Image } from "astro:assets";
import logoImage from "../assets/images/the-kitchen-studio-logo-header.avif";

export interface Props {
  placement: "header" | "menu" | "footer";
}

const LOADING_BY_PLACEMENT = { header: "eager", menu: "lazy", footer: "lazy" } as const;
const PRIORITY_BY_PLACEMENT = { header: "high", menu: "auto", footer: "auto" } as const;
const WIDTH_BY_PLACEMENT = { header: 144, menu: 110, footer: 240 } as const;
const HEIGHT_BY_PLACEMENT = { header: 84, menu: 64, footer: 140 } as const;

const { placement } = Astro.props;
---

<Image
  src={logoImage}
  alt="The Kitchen Studio"
  width={WIDTH_BY_PLACEMENT[placement]}
  height={HEIGHT_BY_PLACEMENT[placement]}
  densities={[1, 2, 3]}
  class={`ks-logo ks-logo-${placement}`}
  format="avif"
  loading={LOADING_BY_PLACEMENT[placement]}
  fetchpriority={PRIORITY_BY_PLACEMENT[placement]}
/>
