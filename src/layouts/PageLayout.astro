---
import Layout from "~/layouts/BaseLayout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";

import type { MetaSEO } from "~/types";

export interface Props {
  meta?: MetaSEO;
  lang?: "EN" | "EL";
  canonicalURL?: string;
  headerTone?: "light" | "overlay";
  footerCta?: boolean;
}

const { meta = {}, lang = "EL", canonicalURL, headerTone = "light", footerCta = true } = Astro.props;

// Pass canonicalURL to MetaTags component
if (canonicalURL && meta) {
  meta.canonicalURL = canonicalURL;
}

// Set language based on page lang
if (lang && meta) {
  meta.language = lang === "EN" ? "en" : "el-GR";
}
---

<Layout {meta}>
  <!-- Pass any structured data to head -->
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  <Header tone={headerTone} />

  <main id="main-content">
    <slot />
  </main>

  <Footer showCta={footerCta} />
</Layout>
