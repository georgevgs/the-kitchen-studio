---
import "~/styles/globals.css";
import "~/styles/fonts.css";
import "~/assets/styles/base.css";

import MetaTags from "~/components/common/MetaTags.astro";
import BasicScripts from "~/components/common/BasicScripts.astro";
import type { MetaSEO } from "~/types";
import { SITE } from "~/config";
import { t } from "~/i18n";
export interface Props {
  meta?: MetaSEO;
}

const { meta = {} } = Astro.props;
const { textDirection = "ltr" } = SITE;

// Derive the document language from the URL so /en/ pages get lang="en"
// regardless of which layout rendered them.
const language = Astro.currentLocale ?? "el";
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <MetaTags {...meta} />
    <slot name="head" />
    <style is:inline>
      /* Critical CSS to prevent FOUC */
      html {
        background-color: #f3f2ee;
      }
      html.dark {
        background-color: #121211;
      }
      body {
        background-color: #f3f2ee;
        color: #151515;
      }
      html.dark body {
        background-color: #121211;
        color: #edebe6;
      }
    </style>
    <script is:inline data-cfasync="false">
      // Apply dark mode before body renders to prevent FOUC
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="antialiased bg-ground text-ink min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-full focus:px-5 focus:py-3 focus:bg-paper focus:text-ink focus:shadow-lg focus:outline-none"
    >
      {t("common.skip_to_content")}
    </a>
    <slot />

    <BasicScripts />
    <script>
      import "~/js/scroll-reveal.ts";
    </script>
  </body>
</html>
